# ---- LLM -------------------------------------------------------------------
# LLM_PROVIDER selects the backend:
#   fake       offline deterministic engine (default; no key, no cost)
#   anthropic  Claude API                (ANTHROPIC_API_KEY)
#   nebius     Nebius Token Factory      (LLM_API_KEY)   <- $ credits
#   groq       Groq                      (LLM_API_KEY)
#   openrouter OpenRouter                (LLM_API_KEY)
#   deepseek   DeepSeek                  (LLM_API_KEY)
#   together   Together AI               (LLM_API_KEY)
#   ollama     local Ollama              (no key; localhost only, will not deploy)
#   lmstudio   local LM Studio           (no key; localhost only)
#   openai     OpenAI                    (OPENAI_API_KEY)
# Each name carries a default base URL. Set LLM_BASE_URL only to override it.
LLM_PROVIDER=fake
LLM_BASE_URL=
# Vendor-neutral key. Set to your NEBIUS_API_KEY / GROQ_API_KEY / etc.
# Takes precedence over OPENAI_API_KEY.
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Large open models with a full research payload often need well over a minute.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Model id, as the chosen backend names it.
#   nebius     browse tokenfactory.nebius.com/models/catalog for exact ids
#   anthropic  claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
# Prefer instruct models over high-reasoning-effort variants: long chains of
# thought inflate latency and risk truncating the JSON these agents must return.
DEFAULT_MODEL=claude-sonnet-5

# Per-task model routing (blank = DEFAULT_MODEL)
PROFILE_MODEL=
ACTIVITY_MODEL=
STEM_MODEL=
RESEARCH_MODEL=
ADMISSION_MODEL=
CRITIC_MODEL=
ACTION_MODEL=
ROADMAP_MODEL=

# ---- Graph limits ----------------------------------------------------------
MAX_COLLEGES_PER_ANALYSIS=8

# COLLEGE_DISCOVERY_MODE: catalog | open | hybrid
#   catalog  pick only from indexed colleges (default). Every candidate has
#            documents to research, so assessments are always possible.
#   open     the model proposes real universities from its own knowledge.
#   hybrid   indexed colleges first, model fills the rest.
# In open/hybrid, a proposed school with no indexed documents is REFUSED by the
# evidence gate, not assessed from model memory. Ingest those schools first
# (scripts/ingest_real_colleges.py) or expect abstentions.
COLLEGE_DISCOVERY_MODE=catalog
MAX_PARALLEL_COLLEGE_WORKERS=5
MAX_RESEARCH_RETRIES=2
MAX_CRITIC_LOOPS=2

# ---- RAG -------------------------------------------------------------------
# VECTOR_BACKEND: memory | pinecone
VECTOR_BACKEND=memory
PINECONE_API_KEY=
PINECONE_INDEX=pathora-colleges

# EMBEDDING_BACKEND: hash | openai_compatible | pinecone
#   hash               offline, free, and NOT semantic. Fine for the seeded demo
#                      corpus; do not pair it with Pinecone — you would pay to
#                      store vectors that carry no meaning.
#   openai_compatible  uses LLM_PROVIDER's endpoint and LLM_API_KEY
#                      Nebius: EMBEDDING_MODEL=BAAI/bge-multilingual-gemma2 (3584)
#                              or Qwen/Qwen3-Embedding-8B
#                      OpenAI: EMBEDDING_MODEL=text-embedding-3-small (1536)
#   pinecone           Pinecone hosted inference, billed to Pinecone
#                      EMBEDDING_MODEL=multilingual-e5-large (1024)
# EMBEDDING_DIM must match both the model and the Pinecone index dimension.
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-multilingual-gemma2
EMBEDDING_DIM=256
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=64

# On-demand lookup: when a researched college has no indexed documents, fetch it
# from College Scorecard, index it, and continue instead of abstaining. This is
# what makes open discovery usable without pre-ingesting every school.
# It makes COVERAGE live, not the figures — admissions data is annual federal
# reporting, so there is no fresher truth to fetch.
LIVE_LOOKUP_ENABLED=true
LIVE_LOOKUP_TIMEOUT=15
LIVE_LOOKUP_TTL_SECONDS=86400
# Minimum name-match score for a federal record. Strict on purpose: accepting a
# branch campus for the flagship silently substitutes a different institution.
SCORECARD_MATCH_THRESHOLD=0.9
SCORECARD_API_KEY=

RAG_TOP_K=6
RAG_RERANK_ENABLED=false
EVIDENCE_STALE_AFTER_DAYS=365
# Annual surveys (IPEDS, Common Data Set) publish on a lag; judging them by the
# page freshness window above would make them permanently unusable.
ANNUAL_SURVEY_STALE_AFTER_DAYS=1095

# ---- Infrastructure --------------------------------------------------------
DATABASE_URL=sqlite+pysqlite:///./pathora.db
REDIS_URL=
# CHECKPOINT_BACKEND: memory | postgres
# memory does not survive a restart: any analysis paused at a human-in-the-loop
# interrupt is lost. Use postgres for anything you would call deployed.
CHECKPOINT_BACKEND=memory

# ---- Observability ---------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pathora-ai

# ---- Transcript ------------------------------------------------------------
# Below this extraction confidence, the graph interrupts for human verification.
EXTRACTION_CONFIDENCE_THRESHOLD=0.75
