# Copy these into the Streamlit Cloud "Secrets" box (App settings -> Secrets).
# Keys are uppercased into environment variables by streamlit_app.py.

# Deployed demo with no model and no cost — deterministic engine:
LLM_PROVIDER = "fake"

# Or a hosted OpenAI-compatible endpoint (works from Streamlit Cloud, unlike Ollama):
# LLM_PROVIDER = "openai"
# LLM_BASE_URL = "https://api.groq.com/openai/v1"
# OPENAI_API_KEY = "gsk_..."
# DEFAULT_MODEL = "llama-3.3-70b-versatile"

# Or Claude:
# LLM_PROVIDER = "anthropic"
# ANTHROPIC_API_KEY = "sk-ant-..."
# DEFAULT_MODEL = "claude-sonnet-5"

MAX_COLLEGES_PER_ANALYSIS = 5
